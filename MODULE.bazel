module(
    name = "yche_distsys_playground",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "platforms", version = "1.0.0")


# Python C++ bindings (pybind11); see bindings/python/
bazel_dep(name = "pybind11_bazel", version = "3.0.0")

# hedron compile_commands uses native py_binary; Bazel 9 removed it — patch + rules_python (issue #279 upstream).
bazel_dep(name = "rules_python", version = "1.7.0", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

# compile_commands.json for clangd / IDE (https://github.com/hedronvision/bazel-compile-commands-extractor)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    patch_strip = 1,
    patches = [
        "//:patches/hedron_bazel9_py_binary.patch",
        "//:patches/hedron_workspace_bazel_out_symlink.patch",
    ],
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

# Minimal bthread API stub so test/smoke brpc adapter targets build without cloning Apache brpc.
# For full Apache brpc RPC e2e, replace this override with a real brpc source/module.
bazel_dep(name = "brpc", version = "1.16.0")
local_path_override(
    module_name = "brpc",
    path = "third_party/brpc_stub_module",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "hiredis",
    build_file = "//third_party:hiredis.BUILD",
    sha256 = "82ad632d31ee05da13b537c124f819eb88e18851d9cb0c30ae0552084811588c",
    strip_prefix = "hiredis-1.2.0",
    urls = ["https://github.com/redis/hiredis/archive/refs/tags/v1.2.0.tar.gz"],
)

# Not bazel_dep("googletest"): BCR release BUILD uses native cc_* (removed in Bazel 9).
http_archive(
    name = "com_google_googletest",
    build_file = "//third_party:googletest.BUILD",
    sha256 = "65fab701d9829d38cb77c14acdc431d2108bfdbf8979e40eb8ae567edf10b27c",
    strip_prefix = "googletest-1.17.0",
    urls = ["https://github.com/google/googletest/releases/download/v1.17.0/googletest-1.17.0.tar.gz"],
)
