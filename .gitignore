# Bazel: convenience symlinks (see .bazelrc --symlink_prefix=build/)
/build/

# Symlink to output_base/external for clangd (compile_commands -Iexternal/...); created by
# `bazel run --config=compile-commands //:refresh_compile_commands` or build.sh after build.
# Ignore the rest of Bazel external repos so `git status` stays quiet, but do NOT ignore
# http_archives that IDEs (e.g. Cursor) need to index alongside compile_commands.json.
/external/*
!/external/+http_archive+com_google_googletest/
!/external/+http_archive+com_google_googletest/**
!/external/+http_archive+hiredis/
!/external/+http_archive+hiredis/**

# Legacy: symlinks at repo root before symlink_prefix (bazel-bin, bazel-out, …)
/bazel-*

# Bazel: optional local output base / disk cache if configured inside the repo
/.bazel-cache/
/.bazel-output/

# Bazel: sandbox runs under the output base (usually ~/.cache/bazel/.../sandbox), not in the repo.
# Ignore a stray top-level sandbox/ if tools ever create one here.
/sandbox/

# Python (pybind / venv)
.venv/
venv/
__pycache__/
*.py[cod]

# Generated by `bazel run --config=compile-commands //:refresh_compile_commands` (optional to commit)
/compile_commands.json

# genhtml output if COVERAGE_HTML_DIR points at repo root (default is build/coverage-html/, covered by /build/)
/coverage-html/

# Editor / OS
*.swp
*~
.DS_Store
