# Bazel: convenience symlinks (see .bazelrc --symlink_prefix=build/)
/build/

# Legacy: symlinks at repo root before symlink_prefix (bazel-bin, bazel-out, …)
/bazel-*

# Bazel: optional local output base / disk cache if configured inside the repo
/.bazel-cache/
/.bazel-output/

# Bazel: sandbox runs under the output base (usually ~/.cache/bazel/.../sandbox), not in the repo.
# Ignore a stray top-level sandbox/ if tools ever create one here.
/sandbox/

# Python (pybind / venv)
.venv/
venv/
__pycache__/
*.py[cod]

# Generated by `bazel run --config=compile-commands //:refresh_compile_commands` (optional to commit)
/compile_commands.json

# genhtml output (docs/coverage.md)
/coverage-html/

# Editor / OS
*.swp
*~
.DS_Store
