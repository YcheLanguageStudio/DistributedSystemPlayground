load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:py_test.bzl", "py_test")

cc_library(
    name = "test_runtime",
    srcs = ["support/test_runtime.cpp"],
    hdrs = ["support/test_runtime.h"],
    includes = ["."],
    visibility = ["//visibility:private"],
    deps = ["//src/kv:kv_core"],
)

cc_test(
    name = "kv_store_test",
    size = "small",
    srcs = ["kv_store_test.cc"],
    deps = [
        ":test_runtime",
        "//src/kv:kv_core",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "brpc_adapter_test",
    size = "small",
    srcs = ["brpc_adapter_test.cc"],
    deps = [
        "//src/adapters/brpc:kv_brpc_adapter",
        "@com_google_googletest//:gtest_main",
    ],
)

py_test(
    name = "kv_store_py_test",
    size = "small",
    srcs = ["kv_store_py_test.py"],
    main = "kv_store_py_test.py",
    deps = ["//bindings/python:yche_kv"],
)
