load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:py_test.bzl", "py_test")

cc_library(
    name = "kv_brpc_test_adapter",
    srcs = ["async_kvcstore/adapters/brpc_runtime.cpp"],
    hdrs = ["async_kvcstore/adapters/brpc_runtime.h"],
    includes = [
        ".",
        "../src/kv/include",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/kv:kv_adapters",
        "@brpc//:brpc",
