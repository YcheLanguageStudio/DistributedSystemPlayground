)

cc_test(
    name = "kv_store_test",
    size = "small",
    srcs = ["kvc_store/kv_store_test.cc"],
    deps = [
        "//src/kv:kv_adapters",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "async_kvcstore_integration_test",
