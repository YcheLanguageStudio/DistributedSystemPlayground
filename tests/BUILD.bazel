    srcs = ["async_kvcstore/integration/brpc_adapter_integration_test.cc"],
    deps = [
        "//src/kv:kv_adapters",
        ":kv_brpc_test_adapter",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "async_kvcstore_thread_pool_test",
    size = "small",
